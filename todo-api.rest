@baseUrl = http://localhost:5000

### Get all tasks
GET {{baseUrl}}/tasks

### Add a task
POST {{baseUrl}}/tasks
Content-Type: application/json

{
  "message": "New task"
}

### Update a task
PUT {{baseUrl}}/tasks/1
Content-Type: application/json

{
  "message": "Updated task"
}

### Delete a task
DELETE {{baseUrl}}/tasks/1

### Missing task returns 404
PUT {{baseUrl}}/tasks/999999
Content-Type: application/json

{
  "message": "This task does not exist"
}
